# Reference values for local synthetic development only. The application does
# not load this file automatically; use your shell/process manager as documented.
ASSET_HUB_DATA_DIR=./var
ASSET_HUB_HOST=127.0.0.1
ASSET_HUB_PORT=5000
ASSET_HUB_DEMO_MODE=true
ASSET_HUB_SECRET_KEY=change-me-before-sharing-on-a-network
# Optional supplier reference (.csv or .xlsx). Keep the real file outside Git.
ASSET_HUB_SUPPLIER_FILE=
# Optional approved accounting template (.xlsx or .xlsm). The bundled template
# has the same 30-column layout but contains no operational data or VBA.
ASSET_HUB_ACCOUNTING_TEMPLATE=
# Optional Oracle organisation ID written to the template's "Org Id" column.
ASSET_HUB_ACCOUNTING_ORG_ID=
# Demo-safe defaults only; replace with approved finance mappings before real use.
ASSET_HUB_DAMAGED_DEBIT_GL=DEMO.COMP.RECEIVABLE
ASSET_HUB_DAMAGED_CREDIT_GL=DEMO.DAMAGED.OFFSET
ASSET_HUB_LOST_DEBIT_GL=DEMO.COMP.RECEIVABLE
ASSET_HUB_LOST_CREDIT_GL=DEMO.LOST.OFFSET
# Optional shared-demo gate. Configure both values together on cloud.
ASSET_HUB_ACCESS_USER=
ASSET_HUB_ACCESS_PASSWORD=
