# Copy to .env.greennode on the GreenNode vServer. Never commit that real file.
ASSET_HUB_SITE_ADDRESS=asset-hub.example.com
ASSET_HUB_HOST_DATA_DIR=/srv/asset-hub/data
ASSET_HUB_IMAGE=asset-compensation-hub:local

# Keep true for the public hackathon demo. Use false before ingesting real data.
ASSET_HUB_DEMO_MODE=true
# Keep false outside a disposable staging server.
ASSET_HUB_ALLOW_TEST_RESET=false
ASSET_HUB_SECRET_KEY=replace-with-at-least-32-random-bytes
ASSET_HUB_ACCESS_USER=judge
ASSET_HUB_ACCESS_PASSWORD=replace-with-a-long-random-password

ASSET_HUB_ACCOUNTING_ORG_ID=DEMO
# Required for source EML download and PDF. Enable only on a trusted server with
# an approved data-retention policy. Drafts additionally require a sender.
ASSET_HUB_RETAIN_RAW_EML=false
ASSET_HUB_DRAFT_FROM_ADDRESS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Approved operational files belong under the persistent host directory, never Git.
# ASSET_HUB_ACCOUNTING_TEMPLATE=/var/data/reference/Template_DENBU2.xlsm
# ASSET_HUB_SUPPLIER_FILE=/var/data/reference/suppliers.xlsx
# ASSET_HUB_FA_GL_REFERENCE=/var/data/reference/fa-gl.xlsx
# ASSET_HUB_CCDC_REFERENCE=/var/data/reference/ccdc.xlsx
# ASSET_HUB_TRAN_TEMPLATE=/var/data/reference/tran-template.xlsx

# Approved semantic accounting mappings belong only in this private env file.
# ASSET_HUB_PREPAYMENT_GL=
# ASSET_HUB_DAMAGED_REPAIR_CREDIT_GL=
# ASSET_HUB_DAMAGED_NO_REPAIR_CREDIT_GL=
# ASSET_HUB_LOST_DEPRECIATION_ASSET_GL_TEMPLATE=
# ASSET_HUB_LOST_DEPRECIATION_OTHER_GL_TEMPLATE=
# ASSET_HUB_LOST_RESPONSIBILITY_GL_TEMPLATE=
