# Copy to .env.greennode on the GreenNode vServer. Never commit that real file.
ASSET_HUB_SITE_ADDRESS=asset-hub.example.com
ASSET_HUB_HOST_DATA_DIR=/srv/asset-hub/data
ASSET_HUB_IMAGE=asset-compensation-hub:local

# Keep true for the public hackathon demo. Use false before ingesting real data.
ASSET_HUB_DEMO_MODE=true
ASSET_HUB_SECRET_KEY=replace-with-at-least-32-random-bytes
ASSET_HUB_ACCESS_USER=judge
ASSET_HUB_ACCESS_PASSWORD=replace-with-a-long-random-password

ASSET_HUB_ACCOUNTING_ORG_ID=DEMO
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Approved operational files belong under the persistent host directory, never Git.
# ASSET_HUB_ACCOUNTING_TEMPLATE=/var/data/reference/Template_DENBU2.xlsm
# ASSET_HUB_SUPPLIER_FILE=/var/data/reference/suppliers.xlsx
